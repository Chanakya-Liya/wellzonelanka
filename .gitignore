# WellzoneLanka.com - Focused .gitignore
# Only includes patterns for files that actually exist or will be generated

# ====================
# PYTHON BACKEND
# ====================

# Virtual Environment (CRITICAL - this is 500MB+)
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Python packages
*.egg-info/
dist/
build/

# ====================
# FRONTEND (Next.js)
# ====================

# Dependencies
node_modules/
/.pnp
.pnp.*

# Next.js
/.next/
/out/
next-env.d.ts

# Production builds
/build

# TypeScript
*.tsbuildinfo

# Package manager files
package-lock.json
yarn.lock
pnpm-lock.yaml

# ====================
# ENVIRONMENT & CONFIG
# ====================

# Environment variables (contains API keys/secrets)
.env
.env.*
.env.local
.env.development
.env.test
.env.production

# ====================
# LOGS & TEMP FILES
# ====================

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
Thumbs.db
*.swp
*.swo

# ====================
# IDE/EDITOR
# ====================

.vscode/
*.code-workspace

# ====================
# PROJECT SPECIFIC
# ====================

# Prisma (if database gets added)
prisma/migrations/

docs/_build/
